# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> homelab-dashboard ###
# Fichier de configuration du dashboard, absolu ou relatif à la racine du projet.
DASHBOARD_CONFIG=examples/dashboard.yaml

# Hub Beszel et compte en lecture seule (état des containers, machines).
# En dev : à renseigner dans .env.local (voir docs/developpement.md).
BESZEL_URL=
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Clé API Jellyfin dédiée au dashboard (carte jellyfin-latest).
JELLYFIN_API_KEY=

# Compte WebUI qBittorrent (carte qbittorrent). qBittorrent n'a pas de compte
# en lecture seule ; le dashboard ne fait que lire.
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Clé API C411, scope « Profil (lecture) » (carte c411).
C411_API_SECRET=

# Jeton GitHub en lecture seule (cartes github-prs) : sans jeton, dépôts publics seulement.
GITHUB_TOKEN=

# Clé d'application Backblaze B2 en lecture seule (carte backblaze).
B2_KEY_ID=
B2_APPLICATION_KEY=

# Mealie : jeton d'API (profil → API Tokens), carte mealie.
MEALIE_API_TOKEN=

# Audiobookshelf : clé d'API (Paramètres → API Keys), carte audiobookshelf.
AUDIOBOOKSHELF_API_KEY=

# Calibre-Web (Automated) : compte sans droits d'écriture pour le flux OPDS, carte calibre-web.
CWA_USERNAME=
CWA_PASSWORD=

# Immich : clé d'API (Paramètres du compte → Clés d'API), carte immich. Permissions :
# asset.read, asset.view, asset.statistics, memory.read. Photos = celles du propriétaire.
IMMICH_API_KEY=

# Autorité de certification à approuver pour les appels HTTPS (CA mkcert en dev).
TLS_CA_FILE=
###< homelab-dashboard ###

# Music Assistant : jeton longue durée d'un utilisateur au rôle Invité (lecture
# de la bibliothèque et des lecteurs), carte music-assistant.
MUSIC_ASSISTANT_TOKEN=

# Jelu : jeton d'API (Profil → API tokens) avec le seul scope reading:read,
# carte jelu. Un jeton suffit pour toute la famille.
JELU_API_TOKEN=

# Crafty Controller : clé d'API (Utilisateurs → modifier → API Keys), sans accès
# complet ni permission cochée, carte crafty.
CRAFTY_API_TOKEN=

# Guild Wars 2 : clé d'API du compte (https://account.arena.net/applications),
# droits account, wallet, progression, tradingpost, carte gw2. Compte d'une autre
# personne : GW2_API_KEY_<NOM>, choisi par l'option `credentials: <nom>` de la carte.
GW2_API_KEY=

# Dossier des clés saisies dans « Mes clés » (un fichier chiffré par profil).
# Vide = var/profiles. En prod : un volume privé, sauvegardé.
PROFILE_DATA_DIR=

# RomM : jeton client (Profil → Client API Tokens) d'un compte Viewer, scopes
# roms.read et platforms.read, carte romm.
ROMM_API_TOKEN=
